import React, { useEffect, useState } from "react"
import { motion, useMotionValue, useSpring } from "framer-motion"
import { addPropertyControls, ControlType } from "framer"

// --- MAIN WRAPPER COMPONENT ---
export function PortfolioDeck(props) {
    const {
        cardWidth,
        cardHeight,
        cardBg,
        borderRadius,
        cardPadding,
        elementSpacing,
        cardSpread,
        titleFontFamily,
        titleFontSize,
        titleFontWeight,
        titleColor,
        tagFontFamily,
        tagFontSize,
        tagFontWeight,
        tagColor,
        captionFontFamily,
        captionFontSize,
        captionFontWeight,
        captionTextColor,
        textBoxBg,
        textBoxOpacity,
        project1Title,
        project1Link,
        project1Image,
        project1Caption,
        project1Tags,
        project2Title,
        project2Link,
        project2Image,
        project2Caption,
        project2Tags,
        project3Title,
        project3Link,
        project3Image,
        project3Caption,
        project3Tags,
        project4Title,
        project4Link,
        project4Image,
        project4Caption,
        project4Tags,
    } = props

    const projects = [
        {
            title: project1Title,
            link: project1Link,
            image: project1Image,
            caption: project1Caption,
            tags: project1Tags,
            angle: -6,
            xOffset: -1 * cardSpread,
            yOffset: 15,
        },
        {
            title: project2Title,
            link: project2Link,
            image: project2Image,
            caption: project2Caption,
            tags: project2Tags,
            angle: -2,
            xOffset: -0.32 * cardSpread,
            yOffset: 2,
        },
        {
            title: project3Title,
            link: project3Link,
            image: project3Image,
            caption: project3Caption,
            tags: project3Tags,
            angle: 2,
            xOffset: 0.32 * cardSpread,
            yOffset: 2,
        },
        {
            title: project4Title,
            link: project4Link,
            image: project4Image,
            caption: project4Caption,
            tags: project4Tags,
            angle: 6,
            xOffset: 1 * cardSpread,
            yOffset: 15,
        },
    ]

    // Hover ownership lives here, as a single value, and is decided purely
    // from cursor position (see handleContainerMouseMove) instead of each
    // card's own DOM mouseenter/mouseleave. When two cards' hit-boxes
    // genuinely overlap on screen, a cursor sitting in that shared sliver
    // can make the browser's hit-test alternate between the two elements
    // from one native mousemove sample to the next — each toggle is a real,
    // legitimate enter/leave pair, not a bug in state handling, so no amount
    // of guarding individual cards' own events fixes it. Computing "which
    // card is under the cursor" as a pure function of (x, y) on every move
    // sidesteps that entirely: the same cursor position always resolves to
    // the same single card, so there's nothing left to oscillate.
    const [hoveredIndex, setHoveredIndex] = useState(null)

    const handleContainerMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {
        const rect = e.currentTarget.getBoundingClientRect()
        const pointerX = e.clientX - rect.left
        const pointerY = e.clientY - rect.top

        // Mirrors the geometry each card's own hit-box is drawn with
        // (hitboxStyle below): a rect cardWidth wide, cardHeight tall,
        // sitting proj.yOffset above the container's bottom edge.
        let matchIndex = null
        projects.forEach((proj, index) => {
            if (!proj.title) return
            const cardLeft = rect.width / 2 - cardWidth / 2 + proj.xOffset
            const cardRight = cardLeft + cardWidth
            // The currently-hovered card's test region is extended up to
            // cover its popped-up position too (a fixed 60px above its
            // un-shifted resting top, same for every card — see the inner
            // motion.div's hover variant), so moving the cursor up into the
            // raised card doesn't read as leaving it. Every other card still
            // only tests its plain resting footprint.
            const cardTop =
                index === hoveredIndex
                    ? rect.height - (40 + cardHeight - 60)
                    : rect.height - (40 - proj.yOffset + cardHeight)
            const cardBottom = rect.height - (40 - proj.yOffset)
            if (
                pointerX >= cardLeft &&
                pointerX <= cardRight &&
                pointerY >= cardTop &&
                pointerY <= cardBottom
            ) {
                // Later entries sit on top by default (see PortfolioCard's
                // zIndex variants), so within an overlap the later index wins.
                matchIndex = index
            }
        })

        setHoveredIndex(matchIndex)
    }

    const handContainerStyle = {
        position: "relative" as const,
        width: "100%",
        minWidth: "750px",
        height: `${cardHeight + 140}px`,
        display: "flex",
        justifyContent: "center",
        alignItems: "flex-end",
        overflow: "visible" as const,
        backgroundColor: "transparent",
        paddingBottom: "40px",
        margin: "0 auto",
    }

    return (
        <div
            style={handContainerStyle}
            onMouseMove={handleContainerMouseMove}
            onMouseLeave={() => setHoveredIndex(null)}
        >
            {projects.map((proj, index) => {
                if (!proj.title) return null
                return (
                    <PortfolioCard
                        key={index}
                        proj={proj}
                        index={index}
                        isHovered={hoveredIndex === index}
                        {...props}
                    />
                )
            })}
        </div>
    )
}

// --- ISOLATED CARD COMPONENT ---
function PortfolioCard({ proj, index, isHovered, ...props }) {
    const {
        cardWidth,
        cardHeight,
        cardBg,
        borderRadius,
        cardPadding,
        elementSpacing,
        titleFontFamily,
        titleFontSize,
        titleFontWeight,
        titleColor,
        tagFontFamily,
        tagFontSize,
        tagFontWeight,
        tagColor,
        captionFontFamily,
        captionFontSize,
        captionFontWeight,
        captionTextColor,
        textBoxBg,
        textBoxOpacity,
    } = props

    const mouseX = useMotionValue(0)
    const mouseY = useMotionValue(0)

    const springConfig = { stiffness: 150, damping: 18 }
    const imageX = useSpring(mouseX, springConfig)
    const imageY = useSpring(mouseY, springConfig)

    // Hover on/off is decided by the container (see handleContainerMouseMove
    // in PortfolioDeck), not by this card's own DOM events, so reset the
    // parallax springs whenever isHovered turns off rather than relying on
    // a mouseleave that this element may no longer be the target of.
    useEffect(() => {
        if (!isHovered) {
            mouseX.set(0)
            mouseY.set(0)
        }
    }, [isHovered])

    const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {
        const rect = e.currentTarget.getBoundingClientRect()
        const relX = (e.clientX - rect.left) / rect.width - 0.5
        const relY = (e.clientY - rect.top) / rect.height - 0.5
        mouseX.set(relX * 18)
        mouseY.set(relY * 18)
    }

    const handleClick = () => {
        if (!proj.link) return
        window.location.href = proj.link
    }

    // Static hit-box: owns mouse events and never changes shape/position on
    // hover, so it can't drift out from under the cursor and cause the
    // hover state to flicker between overlapping cards near the arc centre.
    // Only zIndex (paint order) is allowed to change here.
    const hitboxStyle = {
        position: "absolute" as const,
        width: `${cardWidth}px`,
        height: `${cardHeight}px`,
        bottom: "40px",
        left: `calc(50% - ${cardWidth / 2}px + ${proj.xOffset}px)`,
        cursor: "pointer",
        overflow: "visible" as const,
        y: proj.yOffset,
    }

    // Visual card: purely presentational, free to rotate/translate/scale on
    // hover. It sits inside the static hit-box so pointer events keep
    // targeting a descendant of the hit-box no matter where it visually
    // ends up while animating.
    const visualCardStyle = {
        position: "absolute" as const,
        inset: 0,
        width: "100%",
        height: "100%",
        backgroundColor: cardBg,
        border: "none",
        borderRadius: `${borderRadius}px`,
        padding: `${cardPadding}px`,
        display: "flex",
        flexDirection: "column" as const,
        gap: `${elementSpacing}px`,
        overflow: "visible" as const,
        transformOrigin: "center bottom",
        boxSizing: "border-box" as const,
    }

    const contentImageWrapperStyle = {
        width: "100%",
        flex: 1,
        borderRadius: `${Math.max(0, borderRadius - 6)}px`,
        overflow: "hidden" as const,
        display: "flex",
        justifyContent: "center",
        alignItems: "center",
        backgroundColor: "#EAEAEA",
    }

    const horizontalCaptionStyle = {
        position: "absolute" as const,
        left: `${cardWidth + 10}px`,
        top: "0px",
        width: "220px",
        textAlign: "left" as const,
        pointerEvents: "none" as const,
        display: "flex",
        flexDirection: "column" as const,
        padding: "16px",
        backgroundColor: textBoxBg,
        opacity: textBoxOpacity,
        backdropFilter: "blur(20px) saturate(120%)",
        WebkitBackdropFilter: "blur(20px) saturate(120%)",
        borderRadius: "12px",
        border: "1px solid rgba(255, 255, 255, 0.15)",
        boxShadow: "0px 10px 30px rgba(0, 0, 0, 0.04)",
        zIndex: 9999,
    }

    return (
        <motion.div
            style={hitboxStyle}
            initial="default"
            animate={isHovered ? "hover" : "default"}
            onMouseMove={handleMouseMove}
            onClick={handleClick}
            variants={{
                default: { zIndex: index + 1 },
                hover: { zIndex: 100 },
            }}
            transition={{ zIndex: { duration: 0 } }}
        >
            <motion.div
                style={visualCardStyle}
                initial="default"
                animate={isHovered ? "hover" : "default"}
                whileTap={{ scale: 0.99 }}
                variants={{
                    default: {
                        rotate: proj.angle,
                        y: 0,
                        scale: 1,
                        boxShadow:
                            "0px 4px 10px rgba(0, 0, 0, 0.05), 0px 15px 35px rgba(0, 0, 0, 0.07)",
                    },
                    hover: {
                        rotate: 0,
                        // Outer's constant y:proj.yOffset already shifts the
                        // rendered position; adding another -proj.yOffset here
                        // would double count it and make edge cards (larger
                        // yOffset) pop higher than centre cards. This lands
                        // every card at the same absolute height: 60px above
                        // its un-shifted resting top.
                        y: proj.yOffset - 60,
                        scale: 1.02,
                        boxShadow:
                            "0px 20px 40px rgba(0, 0, 0, 0.12), 0px 8px 16px rgba(0, 0, 0, 0.06)",
                        transition: { type: "spring", stiffness: 350, damping: 22 },
                    },
                }}
            >
                {/* Thumbnail */}
                <div style={contentImageWrapperStyle}>
                    {proj.image ? (
                        <motion.img
                            src={proj.image}
                            alt={proj.title}
                            style={{
                                width: "100%",
                                height: "100%",
                                objectFit: "cover",
                                x: isHovered ? imageX : 0,
                                y: isHovered ? imageY : 0,
                            }}
                            variants={{
                                default: {
                                    scale: 1.0,
                                    filter: "contrast(1) saturate(1)",
                                },
                                hover: {
                                    scale: 1.12,
                                    filter: "contrast(1.04) saturate(1.05)",
                                },
                            }}
                            transition={{
                                duration: 0.4,
                                ease: "easeOut",
                                delay: 0.12,
                            }}
                        />
                    ) : (
                        <motion.div
                            style={{
                                color: "rgba(0,0,0,0.15)",
                                fontSize: "11px",
                                fontFamily: "sans-serif",
                                width: "100%",
                                height: "100%",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                x: isHovered ? imageX : 0,
                                y: isHovered ? imageY : 0,
                            }}
                            variants={{
                                default: { scale: 1 },
                                hover: { scale: 1.08 },
                            }}
                            transition={{
                                duration: 0.4,
                                ease: "easeOut",
                                delay: 0.12,
                            }}
                        >
                            [ Place Mockup Image ]
                        </motion.div>
                    )}
                </div>

                {/* Title */}
                <div>
                    <h3
                        style={{
                            fontSize: `${titleFontSize}px`,
                            fontWeight: titleFontWeight,
                            color: titleColor,
                            margin: 0,
                            fontFamily: titleFontFamily,
                            lineHeight: "1.3",
                            wordBreak: "break-word",
                        }}
                    >
                        {proj.title}
                    </h3>
                </div>

                {/* Tags */}
                {proj.tags && (
                    <p
                        style={{
                            fontFamily: tagFontFamily,
                            fontSize: `${tagFontSize}px`,
                            fontWeight: tagFontWeight,
                            color: tagColor,
                            margin: 0,
                            lineHeight: "1.2",
                            wordBreak: "break-word",
                            marginTop: "auto",
                        }}
                    >
                        {proj.tags}
                    </p>
                )}

                {/* Floating caption */}
                {proj.caption && (
                    <motion.div
                        style={horizontalCaptionStyle}
                        variants={{
                            default: {
                                opacity: 0,
                                x: -10,
                                scale: 0.95,
                                pointerEvents: "none",
                            },
                            hover: {
                                opacity: textBoxOpacity,
                                x: 0,
                                scale: 1,
                                pointerEvents: "auto",
                                transition: { delay: 0.05 },
                            },
                        }}
                    >
                        <p
                            style={{
                                fontSize: `${captionFontSize}px`,
                                fontFamily: captionFontFamily,
                                lineHeight: "1.5",
                                fontWeight: captionFontWeight,
                                margin: 0,
                                whiteSpace: "normal",
                                color:
                                    captionTextColor === "transparent" ||
                                    !captionTextColor
                                        ? titleColor
                                        : captionTextColor,
                            }}
                        >
                            {proj.caption}
                        </p>
                    </motion.div>
                )}
            </motion.div>
        </motion.div>
    )
}

