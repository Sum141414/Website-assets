export function PortfolioDeckMobile(props) {
    const {
        cardWidth,
        cardHeight,
        cardBg,
        borderRadius,
        cardPadding,
        elementSpacing,
        cardGap,
        containerSidePadding,
        titleFontFamily,
        titleFontSize,
        titleFontWeight,
        titleColor,
        tagFontFamily,
        tagFontSize,
        tagFontWeight,
        tagColor,
        captionFontFamily,
        captionFontSize,
        captionFontWeight,
        captionTextColor,
        textBoxBg,
        textBoxOpacity,
        project1Title,
        project1Link,
        project1Image,
        project1Caption,
        project1Tags,
        project2Title,
        project2Link,
        project2Image,
        project2Caption,
        project2Tags,
        project3Title,
        project3Link,
        project3Image,
        project3Caption,
        project3Tags,
        project4Title,
        project4Link,
        project4Image,
        project4Caption,
        project4Tags,
    } = props

    const projects = [
        {
            title: project1Title,
            link: project1Link,
            image: project1Image,
            caption: project1Caption,
            tags: project1Tags,
        },
        {
            title: project2Title,
            link: project2Link,
            image: project2Image,
            caption: project2Caption,
            tags: project2Tags,
        },
        {
            title: project3Title,
            link: project3Link,
            image: project3Image,
            caption: project3Caption,
            tags: project3Tags,
        },
        {
            title: project4Title,
            link: project4Link,
            image: project4Image,
            caption: project4Caption,
            tags: project4Tags,
        },
    ]

    const containerRef = useRef(null)

    // Outer "viewport": clips to the visible row, fixed size so Framer's Frame doesn't collapse it
    const viewportStyle = {
        position: "relative" as const,
        width: "100%",
        height: `${cardHeight + 90}px`,
        overflow: "hidden" as const,
        boxSizing: "border-box" as const,
    }

    // Inner "track": sized to its own content (not the viewport), and dragged horizontally
    const trackStyle = {
        display: "flex",
        gap: `${cardGap}px`,
        width: "max-content", // must size to children, not stretch to 100%, or drag math breaks
        padding: `20px ${containerSidePadding}px 30px ${containerSidePadding}px`,
        boxSizing: "border-box" as const,
        touchAction: "none" as const, // let Framer Motion own the gesture instead of the browser
        cursor: "grab" as const,
    }

    return (
        <div ref={containerRef} style={viewportStyle}>
            <motion.div
                style={trackStyle}
                drag="x"
                dragConstraints={containerRef}
                dragElastic={0.08}
                dragMomentum={true}
                whileTap={{ cursor: "grabbing" }}
            >
                {projects.map((proj, index) => {
                    if (!proj.title) return null
                    return (
                        <PortfolioCardMobile
                            key={index}
                            proj={proj}
                            cardWidth={cardWidth}
                            cardHeight={cardHeight}
                            cardBg={cardBg}
                            borderRadius={borderRadius}
                            cardPadding={cardPadding}
                            elementSpacing={elementSpacing}
                            titleFontFamily={titleFontFamily}
                            titleFontSize={titleFontSize}
                            titleFontWeight={titleFontWeight}
                            titleColor={titleColor}
                            tagFontFamily={tagFontFamily}
                            tagFontSize={tagFontSize}
                            tagFontWeight={tagFontWeight}
                            tagColor={tagColor}
                            captionFontFamily={captionFontFamily}
                            captionFontSize={captionFontSize}
                            captionFontWeight={captionFontWeight}
                            captionTextColor={captionTextColor}
                            textBoxBg={textBoxBg}
                            textBoxOpacity={textBoxOpacity}
                        />
                    )
                })}
            </motion.div>
        </div>
    )
}

function PortfolioCardMobile({ proj, ...props }) {
    const {
        cardWidth,
        cardHeight,
        cardBg,
        borderRadius,
        cardPadding,
        elementSpacing,
        titleFontFamily,
        titleFontSize,
        titleFontWeight,
        titleColor,
        tagFontFamily,
        tagFontSize,
        tagFontWeight,
        tagColor,
        captionFontFamily,
        captionFontSize,
        captionFontWeight,
        captionTextColor,
        textBoxBg,
        textBoxOpacity,
    } = props

    const [showCaption, setShowCaption] = useState(false)

    const cardStyle = {
        position: "relative" as const,
        flex: `0 0 ${cardWidth}px`,
        width: `${cardWidth}px`,
        height: `${cardHeight}px`,
        backgroundColor: cardBg,
        borderRadius: `${borderRadius}px`,
        padding: `${cardPadding}px`,
        display: "flex",
        flexDirection: "column" as const,
        gap: `${elementSpacing}px`,
        boxSizing: "border-box" as const,
        boxShadow:
            "0px 4px 10px rgba(0, 0, 0, 0.05), 0px 15px 35px rgba(0, 0, 0, 0.07)",
        cursor: "pointer",
    }

    const imageWrapperStyle = {
        position: "relative" as const,
        width: "100%",
        flex: 1,
        borderRadius: `${Math.max(0, borderRadius - 6)}px`,
        overflow: "hidden" as const,
        backgroundColor: "#EAEAEA",
    }

    const infoButtonStyle = {
        position: "absolute" as const,
        top: "10px",
        right: "10px",
        width: "28px",
        height: "28px",
        borderRadius: "50%",
        backgroundColor: "rgba(255,255,255,0.85)",
        backdropFilter: "blur(6px)",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        fontSize: "13px",
        fontFamily: "Georgia, serif",
        fontStyle: "italic" as const,
        color: "#111",
        zIndex: 10,
    }

    const captionOverlayStyle = {
        position: "absolute" as const,
        left: 0,
        right: 0,
        bottom: 0,
        padding: "14px",
        backgroundColor: textBoxBg,
        opacity: textBoxOpacity,
        backdropFilter: "blur(20px) saturate(120%)",
        WebkitBackdropFilter: "blur(20px) saturate(120%)",
        borderTop: "1px solid rgba(255,255,255,0.15)",
    }

    const handleInfoTap = (e: React.MouseEvent) => {
        e.stopPropagation()
        setShowCaption((v) => !v)
    }

    const cardContent = (
        <div style={cardStyle}>
            <div style={imageWrapperStyle}>
                {proj.image ? (
                    <img
                        src={proj.image}
                        alt={proj.title}
                        style={{
                            width: "100%",
                            height: "100%",
                            objectFit: "cover",
                        }}
                    />
                ) : (
                    <div
                        style={{
                            color: "rgba(0,0,0,0.15)",
                            fontSize: "11px",
                            fontFamily: "sans-serif",
                            width: "100%",
                            height: "100%",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                        }}
                    >
                        [ Place Mockup Image ]
                    </div>
                )}

                {proj.caption && (
                    <div style={infoButtonStyle} onClick={handleInfoTap}>
                        i
                    </div>
                )}

                <AnimatePresence>
                    {showCaption && proj.caption && (
                        <motion.div
                            style={captionOverlayStyle}
                            initial={{ opacity: 0, y: 12 }}
                            animate={{ opacity: 1, y: 0 }}
                            exit={{ opacity: 0, y: 12 }}
                            transition={{ duration: 0.25, ease: "easeOut" }}
                            onClick={(e) => e.stopPropagation()}
                        >
                            <p
                                style={{
                                    fontSize: `${captionFontSize}px`,
                                    fontFamily: captionFontFamily,
                                    lineHeight: "1.5",
                                    fontWeight: captionFontWeight,
                                    margin: 0,
                                    color:
                                        captionTextColor === "transparent" ||
                                        !captionTextColor
                                            ? titleColor
                                            : captionTextColor,
                                }}
                            >
                                {proj.caption}
                            </p>
                        </motion.div>
                    )}
                </AnimatePresence>
            </div>

            <div>
                <h3
                    style={{
                        fontSize: `${titleFontSize}px`,
                        fontWeight: titleFontWeight,
                        color: titleColor,
                        margin: 0,
                        fontFamily: titleFontFamily,
                        lineHeight: "1.3",
                        wordBreak: "break-word",
                    }}
                >
                    {proj.title}
                </h3>
            </div>

            {proj.tags && (
                <p
                    style={{
                        fontFamily: tagFontFamily,
                        fontSize: `${tagFontSize}px`,
                        fontWeight: tagFontWeight,
                        color: tagColor,
                        margin: 0,
                        lineHeight: "1.2",
                        wordBreak: "break-word",
                    }}
                >
                    {proj.tags}
                </p>
            )}
        </div>
    )

    if (!proj.link) {
        return cardContent
    }

    return (
        <Link href={proj.link} style={{ display: "contents" }}>
            {cardContent}
        </Link>
    )
}

